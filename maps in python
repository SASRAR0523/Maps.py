# Write a program that takes a single line of input, which is a string, and prints the occurrence of all characters in the given string.

s = input()

count = {}

for ch in s:
    ch = ch.lower()

    if ch == " ":
        continue

    if ch in count:
        count[ch] += 1
    else:
        count[ch] = 1

for ch in count:
    print(ch + ":" + str(count[ch]))

