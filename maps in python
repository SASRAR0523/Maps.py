# Given a string s, reverse only the vowels of the string and return the resulting string.
# The vowels are 'a', 'e', 'i', 'o', 'u', and they can appear in both lowercase and uppercase forms.

s = list(input())

vowels = "aeiouAEIOU"

left = 0
right = len(s) - 1

while left < right:
    if s[left] not in vowels:
        left += 1
    elif s[right] not in vowels:
        right -= 1
    else:
        s[left], s[right] = s[right], s[left]
        left += 1
        right -= 1

print("".join(s))









